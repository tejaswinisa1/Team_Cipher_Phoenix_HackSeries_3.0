# ── AI Policy Engine ──────────────────────────────────────────────────────────
# Groq API key for LLM-backed policy evaluation (uncertain cases only).
# Get one free at https://console.groq.com
# If not set, the system falls back to deterministic rules — demo still works.
GROQ_API_KEY=your_groq_api_key

# ── Algorand TestNet ──────────────────────────────────────────────────────────
# Public AlgoNode TestNet endpoint — no token required (use 64 'a' chars as placeholder).
ALGORAND_TOKEN=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
ALGORAND_SERVER=https://testnet-api.algonode.cloud
ALGORAND_PORT=

# App ID of the deployed ConsentContract on TestNet.
# REQUIRED for on-chain execution. Get it by running:
#   cd contracts && python deploy.py
# Then paste the printed App ID here and restart the backend.
ALGORAND_APP_ID=your_deployed_app_id

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL and service-role key from Supabase → Settings → API.
# The service-role key bypasses RLS — keep it server-side only.
# REQUIRED — the backend will not start without these.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
